{
  "ConnectionStrings": {
    "SupabaseDb": "Host=YOUR_HOST;Port=5432;Database=postgres;Username=postgres;Password=YOUR_PASSWORD;SSL Mode=Require;Trust Server Certificate=true"
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:8081",
      "http://localhost:19006"
    ]
  },
  "Security": {
    "KeepaliveSecret": "local-keepalive-secret"
  },
  "Cache": {
    "TtlMinutes": 1
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "PillApp.Api": "Debug"
    }
  }
}
